<UserControl 
    x:Class="Effani.Device.UI.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
	xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
    xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
    xmlns:control="clr-namespace:Drivetrain.Robotics.Control;assembly=Drivetrain.Robotics.Control"
    xmlns:local="clr-namespace:Effani.Device.UI"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
	d:DataContext="{d:DesignInstance Type=local:UtilitiesViewModel}"
    mc:Ignorable="d" d:DesignHeight="1024" d:DesignWidth="1980">
    <UserControl.Resources>
        <x:Array x:Key="LaserPortKinds" Type="{x:Type control:PortKind}">
            <control:PortKind>Output</control:PortKind>
            <control:PortKind>IoOutput</control:PortKind>
            <control:PortKind>Laser</control:PortKind>
        </x:Array>
        <SolidColorBrush  x:Key="LevelOneColor" Color="#efefef"/>
        <SolidColorBrush  x:Key="LevelTwoColor" Color="#dfdfdf"/>
        <SolidColorBrush  x:Key="LevelThreeColor" Color="#d0d0d0"/>
        <Style TargetType="GroupBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style TargetType="dxlc:LayoutItemLabel">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="dxlc:LayoutItem">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="LabelPosition" Value="Left"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <!-- settings written to the board's config files (config.g, homeX.g, ...): the board only uses a change once the config is generated and sent -->
        <SolidColorBrush x:Key="ConfigSettingColor" Color="#1F5FA8"/>
        <Style x:Key="ConfigSettingLabel" TargetType="dxlc:LayoutItemLabel" BasedOn="{StaticResource {x:Type dxlc:LayoutItemLabel}}">
            <Setter Property="Foreground" Value="{StaticResource ConfigSettingColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ConfigSetting" TargetType="dxlc:LayoutItem" BasedOn="{StaticResource {x:Type dxlc:LayoutItem}}">
            <Setter Property="LabelStyle" Value="{StaticResource ConfigSettingLabel}"/>
        </Style>
        <Style TargetType="dxlc:LayoutGroup">
            <Setter Property="ItemSpace" Value="10"/>
            <Setter Property="IsCollapsible" Value="True"/>
        </Style>
        <!-- spin arrows wide enough to hit with a finger -->
        <Style TargetType="dxe:SpinButton"><Setter Property="MinWidth" Value="40"/></Style>
        <Style TargetType="dxe:SpinEdit" >
            <Setter Property="MaxWidth" Value="140"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <!-- touchscreen-sized text, password and drop-down editors -->
        <Style TargetType="dxe:TextEdit">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style TargetType="dxe:PasswordBoxEdit">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style TargetType="dxe:ComboBoxEdit">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <!-- settings the device control reads while running: locked, with an explanation, while an assay is running -->
        <Style x:Key="DeviceControlSetting" TargetType="dxe:SpinEdit" BasedOn="{StaticResource {x:Type dxe:SpinEdit}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=DataContext.IsAssayRunning, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsControl}}}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                    <Setter Property="ToolTip" Value="This setting is in use by the device control while an assay is running, so it cannot be changed until the assay is finished or canceled."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- the serial port: switching it would cut off the commands still queued or executing, so it is locked until the queue is empty -->
        <Style x:Key="SerialPortSetting" TargetType="dxe:SpinEdit" BasedOn="{StaticResource {x:Type dxe:SpinEdit}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=DataContext.IsCommandQueueBusy, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsControl}}}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                    <Setter Property="ToolTip" Value="Commands are queued or executing, so the COM port cannot be changed until they have all finished."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- turns amber when a setting that goes into the board's config has changed since the config was last sent to the board -->
        <Style x:Key="GenerateConfigButton" TargetType="dx:SimpleButton">
            <Setter Property="Content" Value="Generate Config"/>
            <Setter Property="ToolTip" Value="Generate config.g and the homing files from the settings and send them to the controller board, which is then rebooted"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="17"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConfigNeedsGenerating}" Value="True">
                    <Setter Property="Background" Value="#FFB300"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Content" Value="Generate Config - settings changed"/>
                    <Setter Property="ToolTip" Value="Settings that go into the board's config have changed since it was last sent to the board. Click to generate the config files and send them to the controller board, which is then rebooted."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="dxlc:GroupBox">
            <!-- a group title big enough to read on the touchscreen -->
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="16" Margin="0,3,0,3" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TitleBackground" Value="Gray"/>
            <Setter Property="TitleForeground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource LevelTwoColor}"/>
        </Style>
        <Style x:Key="tertiaryGroupBox" TargetType="dxlc:GroupBox">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="15" Margin="0,2,0,2" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TitleBackground" Value="#b1b1b1"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource LevelThreeColor}"/>
        </Style>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxwui:WinUIDialogService>
            <dxwui:WinUIDialogService.ViewTemplate>
                <DataTemplate>
                    <dxlc:LayoutItem Label="How would you like to describe these settings?" LabelPosition="Top">
                        <dxe:TextEdit NullText="Settings Description" EditValue="{Binding NewSettingsDescription}"/>
                    </dxlc:LayoutItem>
                </DataTemplate>
            </dxwui:WinUIDialogService.ViewTemplate>
        </dxwui:WinUIDialogService>
    </dxmvvm:Interaction.Behaviors>
    <DockPanel LastChildFill="True" Background="{StaticResource LevelOneColor}">
        <StackPanel HorizontalAlignment="Left" DockPanel.Dock="Top" Margin="20,20,0,0">
            <Label Content="Active Settings" FontSize="15" />
            <StackPanel Orientation="Horizontal">
                <dxe:ComboBoxEdit
					FontSize="17" MinWidth="320" MinHeight="52"
					ItemsSource="{Binding SettingsVersions}"
					DisplayMember="Description"
					IsTextEditable="False"
					EditValue="{Binding ActiveSettingsVersion, Mode=OneWay}"
					SelectedIndexChanged="ComboBoxEdit_SelectedIndexChanged">
                    <dxe:ComboBoxEdit.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <dx:SimpleButton HorizontalAlignment="Left" Margin="0" Padding="0" BorderThickness="0" Width="44" Height="44" 
												 ToolTip="{DXBinding '@a($dxe:ComboBoxEdit).DataContext.ActiveSettingsVersion != @c ? `Delete these settings` : `Active settings cannot be deleted`'}" 
												 IsEnabled="{DXBinding '@a($dxe:ComboBoxEdit).DataContext.ActiveSettingsVersion != @c'}">
                                    <dx:SimpleButton.Content>
                                        <Image Source="{dx:DXImage 'SvgImages/Dashboards/Delete.svg'}" />
                                    </dx:SimpleButton.Content>
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:ConfirmationBehavior 
											EnableConfirmationMessage="True"
											Command="{Binding Path=DataContext.DeleteSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type dxe:ComboBoxEdit}}}"
											CommandParameter="{Binding}"
											MessageText="{DXBinding '`Are you sure to delete the &quot;` + @c.Description + `&quot; settings?`'}"  
											MessageIcon="Question" MessageTitle="Delete Settings"/>
                                    </dxmvvm:Interaction.Behaviors>
                                </dx:SimpleButton>
                                <TextBlock FontSize="17" VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding Description}"/>
                            </StackPanel>
                        </DataTemplate>
                    </dxe:ComboBoxEdit.ItemTemplate>
                </dxe:ComboBoxEdit>
                <dx:SimpleButton Margin="5,0,0,0" CornerRadius="5" Width="52" Padding="4" Background="AliceBlue" Height="52" ToolTip="Save these settings as..." Command="{Binding SaveActiveSettingsAsNewVersionCommand}">
                    <dx:SimpleButton.Content>
                        <Image Source="{dx:DXImage 'SvgImages/Save/SaveDialog.svg'}" />
                    </dx:SimpleButton.Content>
                </dx:SimpleButton>
                <dx:SimpleButton Margin="5,0,0,0" Glyph="../resources/Reset.svg" CornerRadius="5" Width="52" Padding="4" Background="AliceBlue" Height="52" ToolTip="Reset settings to their default values." Command="{Binding ResetActiveSettingsCommand}"/>
                <dx:SimpleButton Style="{StaticResource GenerateConfigButton}" Margin="30,0,0,0" CornerRadius="5" Padding="20,0,20,0" Height="52" FontSize="17" Command="{Binding GenerateConfigFilesCommand}"/>
                <!--<dx:SimpleButton Margin="5,0,0,0" Glyph="../resources/Upload.svg" CornerRadius="5" Width="52" Padding="4" Background="AliceBlue" Height="52" ToolTip="Upload these settings to the cloud" Command="{Binding UploadSettingsCommand}"/>
                <dx:SimpleButton Margin="5,0,0,0" Glyph="../resources/Download.svg" CornerRadius="5" Width="52" Padding="4" Background="AliceBlue" Height="52" ToolTip="Download these settings from the cloud" Command="{Binding DownloadSettingsCommand}"/>-->
            </StackPanel>
            <TextBlock Margin="0,8,0,0" FontSize="15" TextWrapping="Wrap">
                <Run Text="Blue settings" Foreground="{StaticResource ConfigSettingColor}" FontWeight="SemiBold"/><Run Text=" are written to the board's config: after changing one, press Generate Config so the board uses it."/>
            </TextBlock>
        </StackPanel>
        <!-- table of contents: a major heading for every page of settings and, under it, a heading for every group on that page. Choosing a
             heading shows its settings on the right. The headings are built in the code-behind from the tab items and layout groups below,
             so a page or group added there appears here by itself. -->
        <TreeView x:Name="Contents" DockPanel.Dock="Left" Width="390" Margin="20,20,0,10" SelectedItemChanged="Contents_SelectedItemChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.PanningMode="VerticalOnly" />
        <!-- what the settings on show control: the note (local:SettingsControl.Note) of the chosen group, or of what it is nested in, or of its page -->
        <Border x:Name="NotePanel" DockPanel.Dock="Bottom" Margin="10,8,0,10" Padding="14,10,14,10" CornerRadius="4" Background="{StaticResource LevelTwoColor}" Visibility="Collapsed">
            <TextBlock x:Name="NoteText" TextWrapping="Wrap" FontSize="17" />
        </Border>
        <dx:DXTabControl x:Name="SettingsPages" Margin="10,20,0,0" DataContext="{Binding Path=Settings}">
            <!-- the pages are chosen from the table of contents, so the tab headers are not shown -->
            <dx:DXTabControl.View>
                <dx:TabControlMultiLineView HeaderLocation="None" />
            </dx:DXTabControl.View>
            <dx:DXTabItem Header="Fluid Emission" local:SettingsControl.Note="How much of each fluid the pumps dispense, how the pumps are primed, how far a syringe moves per microlitre, and how the aspiration needle removes fluid from a well.">
                <dxlc:LayoutControl Orientation="Horizontal">
                    <dxlc:LayoutGroup>
                    <dxlc:FlowLayoutControl Orientation="Horizontal" ItemSpace="10">
                        <dxlc:LayoutGroup View="GroupBox" Header="Emission Volumes (μl)" local:SettingsControl.Note="The volume of each fluid dispensed into a sample well during an assay." ToolTip="Fluid volume dispensed to a sample well" Orientation="Vertical" >
                            <dxlc:LayoutItem Label="NADH">
                                <dxe:SpinEdit EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding NadhVolume}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="DNA Reagent">
                                <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding DnaVolume}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="KOH">
                                <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding KohVolume}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Basal Media">
                                <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding BasalVolume}" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox" Header="Priming Volumes (μl)" local:SettingsControl.Note="The volume each pump pushes out to fill its line before it dispenses into wells: once when the fluids are loaded (initial priming), and again whenever a pump has stood idle for too long (secondary priming)." Orientation="Horizontal">
                            <dxlc:LayoutGroup View="GroupBox" Header="Initial Priming" local:SettingsControl.Note="The volume each pump dispenses to fill its line when the fluids are loaded at the start of an assay." ToolTip="Volume dispensed during first pump priming" Orientation="Vertical" GroupBoxStyle="{StaticResource tertiaryGroupBox}">
                                <dxlc:LayoutItem Label="NADH">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding InitialNadhFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="DNA Reagent">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding InitialDnaFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="KOH">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding InitialKohFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Basal Media">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding InitialBasalFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup View="GroupBox" Header="Secondary Priming" local:SettingsControl.Note="The volume a pump dispenses at the waste location to refresh its line when it has not been used for longer than the Reprime Pump Interval." ToolTip="Volume dispensed during second pump priming" Orientation="Vertical" GroupBoxStyle="{StaticResource tertiaryGroupBox}">
                                <dxlc:LayoutItem Label="NADH">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding SecondaryNadhFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="DNA Reagent">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding SecondaryDnaFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="KOH">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding SecondaryKohFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Basal Media">
                                    <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding SecondaryBasalFluidPrimingVolume}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem Label="Reprime Pump Interval (min)">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="600" EditValue="{Binding ReprimePumpInterval}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox" Header="Syringe Travel (mm/μl)" local:SettingsControl.Note="How far each pump's syringe moves to dispense one microlitre. Every volume is turned into actuator travel with this, so it sets the accuracy of each dispense." Orientation="Vertical">
                            <dxlc:LayoutItem Label="NADH" ToolTip="">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="0.00001" MinValue="0.00001" MaxValue="0.1" EditValue="{Binding NadhTravelPerMicroLiter}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="DNA Reagent" ToolTip="">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="0.00001" MinValue="0.00001" MaxValue="0.1" EditValue="{Binding DnaTravelPerMicroLiter}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="KOH" ToolTip="">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="0.00001" MinValue="0.00001" MaxValue="0.1" EditValue="{Binding KohTravelPerMicroLiter}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Basal Media" ToolTip="">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="0.00001" MinValue="0.00001" MaxValue="0.1" EditValue="{Binding BasalTravelPerMicroLiter}" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox" Header="Syringe Loading Positions (mm from 0)" local:SettingsControl.Note="The position each pump's actuator moves to so that its syringe can be loaded, in mm from the actuator's zero position." Orientation="Vertical">
                            <dxlc:LayoutItem Label="NADH" ToolTip="">
                                <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="10000" EditValue="{Binding NadhSyringeLoadingPosition}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="DNA Reagent" ToolTip="">
                                <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="10000" EditValue="{Binding DnaSyringeLoadingPosition}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="KOH" ToolTip="">
                                <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="10000" EditValue="{Binding KohSyringeLoadingPosition}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Basal Media" ToolTip="">
                                <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="10000" EditValue="{Binding BasalSyringeLoadingPosition}" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox" Header="Emission Speed" local:SettingsControl.Note="How fast a syringe moves while it dispenses or primes, and how long the device waits after dispensing before it moves on." Orientation="Vertical">
                            <dxlc:LayoutItem Label="Fluid Syringe Speed (mm/min)" ToolTip="Speed at which a fluid syringe moves while emitting or priming, in mm/min (sent as the F of each emission move; 5 mm/min is about 0.08 mm/s). The board holds it to the pump's Max Speed.">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="0.5" MinValue="0.1" MaxValue="2000" EditValue="{Binding FluidSyringeSpeed}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Fluid Emission Pause (ms)" ToolTip="Milliseconds to wait before moving after dispensing fluid">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding FluidEmissionDwell}" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup View="GroupBox" Header="Aspiration" local:SettingsControl.Note="How the aspiration needle removes fluid from a well: where the needle starts, how far it is from the tray, how far it travels for each microlitre removed, and how fast it moves into position." Orientation="Vertical">
                            <dxlc:LayoutItem Label="Aspirate Needle Start Position" ToolTip="The starting position (mm) of a the KOH aspiration needle">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding AspirateActuatorStartPosition}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Aspirate Distrance to Tray" ToolTip="The distance (mm) between the tip of the KOH aspiration needle and the top of the sample tray">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="1" MinValue="0" MaxValue="100" EditValue="{Binding AspirateDistanceToPlate}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Aspirate Travel Per Microliter" ToolTip="The distance (mm) the aspiration needle travels in order to remove 1μl">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="1" MinValue="0" MaxValue="100" EditValue="{Binding AspirateTravelPerMicroLiter}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Aspirate Positioning Speed (mm/min)" ToolTip="Speed (mm/min) at which the aspiration needle moves to the sample tray before aspirating">
                                <dxe:SpinEdit Style="{StaticResource DeviceControlSetting}" IsFloatValue="True" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding AspiratePositioningSpeed}" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                    </dxlc:FlowLayoutControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </dx:DXTabItem>
            <dx:DXTabItem Header="Component Locations" local:SettingsControl.Note="Where the sensors and the sample trays are on the table, and the size and spacing of the trays and their wells. The table uses these to bring each well to a sensor or a fluid port.">
                <dxlc:LayoutControl Orientation="Horizontal">
                    <dxlc:LayoutGroup View="GroupBox" Header="Sensor Locations" local:SettingsControl.Note="The table coordinates of the DNA and NADH sensors. A well is moved to one of these when its reading is taken." Orientation="Vertical">
                        <dxlc:LayoutItem LabelPosition="Top" Label="DNA" ToolTip="Platform coordinates (mm x mm) of the location at which DNA readings are taken">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding DnaSensorLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding DnaSensorLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="NADH" ToolTip="Platform coordinates (mm x mm) of the location at which NADH readings are taken">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding NadhSensorLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding NadhSensorLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup View="GroupBox" Header="Tray Carrier Locations" local:SettingsControl.Note="Where the first well of the first tray is on the table, and where the table moves to so that trays can be loaded. The position of every other well is worked out from the first well." Orientation="Vertical">
                        <dxlc:LayoutItem LabelPosition="Top" Label="First Well Location" ToolTip="Platform coordinates (mm x mm) of the location of the lower left corner of the first sample well">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding FirstWellLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding FirstWellLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="Tray Loading Location" ToolTip="Platform coordinates (mm x mm) of the location at which sample trays are loaded">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding TrayLoadingLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding TrayLoadingLocationY}" />
                                </dxlc:LayoutItem>
