<dx:ThemedWindow
    x:Class="Effani.Device.UI.OnScreenInputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="Type a value" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
    WindowStartupLocation="Manual" SizeToContent="Height" Width="980" FontSize="18">
    <dx:ThemedWindow.Resources>
        <!-- spin arrows wide enough to hit with a finger -->
        <Style TargetType="dxe:SpinButton"><Setter Property="MinWidth" Value="56"/></Style>
    </dx:ThemedWindow.Resources>
    <!-- a copy of the field that was touched, shown just above the on-screen keyboard so that what is typed can be seen -->
    <Border BorderBrush="#1E88E5" BorderThickness="3" Padding="22,14,22,18">
        <StackPanel>
            <TextBlock x:Name="Caption" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="Hint" Margin="0,4,0,0" Opacity="0.75" FontSize="15" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="62" />
            <DockPanel Margin="0,14,0,0">
                <dx:SimpleButton DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="150" MinHeight="64" FontSize="22" CornerRadius="5" Margin="12,0,0,0"
                                 ToolTip="Close without changing the field" Click="Cancel_Click" />
                <dx:SimpleButton DockPanel.Dock="Right" Content="OK" IsDefault="True" MinWidth="150" MinHeight="64" FontSize="22" CornerRadius="5" Margin="16,0,0,0"
                                 ToolTip="Put what was typed into the field" Click="Accept_Click" />
                <ContentControl x:Name="EditorHost" Focusable="False" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="Problem" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#C62828" FontWeight="SemiBold" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</dx:ThemedWindow>
