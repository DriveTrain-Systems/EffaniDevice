                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="100" MinValue="1" MaxValue="100000" EditValue="{Binding KohMoveSpeed}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Acceleration (mm/s²)" ToolTip="Acceleration of the KOH pump axis (M201).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding KohAcceleration}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Max Speed Change (mm/min)" ToolTip="Maximum instantaneous speed change (jerk) of the KOH pump axis (M566).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding KohMaxInstantaneousSpeedChange}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Direction" ToolTip="Direction the KOH axis motor turns for positive movement. Change this if the axis moves the wrong way.">
                                        <dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type control:Direction}}" EditValue="{Binding KohDirection}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Endstop Location" ToolTip="Which end of the KOH axis travel its endstop switch is at (M574 in config.g). Homing moves towards this end, then backs off 5 mm and homes again slowly; once homed the axis is at 0 (Low End) or at the top of its travel (High End). If homing heads the wrong way although this is right, change Direction (above) instead. Generate and send the config after changing it.">
                                        <dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type control:EndstopLocation}}" EditValue="{Binding KohEndstopLocation}" />
                                    </dxlc:LayoutItem>
                                </dxlc:LayoutGroup>
                                <dxlc:LayoutGroup View="GroupBox" Header="NADH" Orientation="Vertical">
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Steps per mm" ToolTip="Motor steps (including 16x microstepping) per mm of NADH pump travel. Written to config.g with M92. For a 1.8 degree motor with a 2.54 mm lead screw: 200 x 16 / 2.54 = 1259.84.">
                                        <dxe:SpinEdit IsFloatValue="True" EditValueType="{x:Type sys:Decimal}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding NadhStepsPerMillimeter}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Max Travel (mm)" ToolTip="Usable travel of the NADH pump actuator in mm (upper limit of M208). Homing distance is based on this, so keep it below the actuator's stroke.">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding NadhTravelLength}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Current (mA)" ToolTip="RMS motor current for the NADH pump motor in mA (M906). The LMD14S13GF15-120 actuator is rated 1.5 A per phase; 60-85% of that (900-1275 mA) runs cooler if it gives enough thrust.">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding NadhMotorCurrent}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Driver Mode" ToolTip="How the NADH pump motor's driver regulates its current (M569 D). StealthChop (D3) is near silent, including while the motor holds still; SpreadCycle (D2) gives full torque at all speeds but can whine or squeal while the motor stands still. Takes effect when the config is generated and sent to the board.">
                                        <dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type control:DriverMode}}" EditValue="{Binding NadhDriverMode}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Max Speed (mm/min)" ToolTip="The fastest the NADH pump axis may go (M203 in config.g): the board holds every move to this, and homing too. Generate and send the config after changing it.">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding NadhMaxSpeed}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Move Speed (mm/min)" ToolTip="The speed of the NADH pump axis's moves, sent with each move, so a change takes effect without sending the config. It cannot go above the Max Speed: a higher value runs at the Max Speed (Generate Config warns about it). Pumping and aspirating use their own speeds.">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="100" MinValue="1" MaxValue="100000" EditValue="{Binding NadhMoveSpeed}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Acceleration (mm/s²)" ToolTip="Acceleration of the NADH pump axis (M201).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding NadhAcceleration}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Max Speed Change (mm/min)" ToolTip="Maximum instantaneous speed change (jerk) of the NADH pump axis (M566).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding NadhMaxInstantaneousSpeedChange}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Direction" ToolTip="Direction the NADH axis motor turns for positive movement. Change this if the axis moves the wrong way.">
                                        <dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type control:Direction}}" EditValue="{Binding NadhDirection}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Endstop Location" ToolTip="Which end of the NADH axis travel its endstop switch is at (M574 in config.g). Homing moves towards this end, then backs off 5 mm and homes again slowly; once homed the axis is at 0 (Low End) or at the top of its travel (High End). If homing heads the wrong way although this is right, change Direction (above) instead. Generate and send the config after changing it.">
                                        <dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type control:EndstopLocation}}" EditValue="{Binding NadhEndstopLocation}" />
                                    </dxlc:LayoutItem>
                                </dxlc:LayoutGroup>
                                <dxlc:LayoutGroup View="GroupBox" Header="Basal" Orientation="Vertical">
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Steps per mm" ToolTip="Motor steps (including 16x microstepping) per mm of Basal pump travel. Written to config.g with M92. For a 1.8 degree motor with a 2.54 mm lead screw: 200 x 16 / 2.54 = 1259.84.">
                                        <dxe:SpinEdit IsFloatValue="True" EditValueType="{x:Type sys:Decimal}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding BasalStepsPerMillimeter}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Max Travel (mm)" ToolTip="Usable travel of the Basal pump actuator in mm (upper limit of M208). Homing distance is based on this, so keep it below the actuator's stroke.">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding BasalTravelLength}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Current (mA)" ToolTip="RMS motor current for the Basal pump motor in mA (M906). The LMD14S13GF15-120 actuator is rated 1.5 A per phase; 60-85% of that (900-1275 mA) runs cooler if it gives enough thrust.">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding BasalMotorCurrent}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Driver Mode" ToolTip="How the Basal pump motor's driver regulates its current (M569 D). StealthChop (D3) is near silent, including while the motor holds still; SpreadCycle (D2) gives full torque at all speeds but can whine or squeal while the motor stands still. Takes effect when the config is generated and sent to the board.">
                                        <dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type control:DriverMode}}" EditValue="{Binding BasalDriverMode}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Max Speed (mm/min)" ToolTip="The fastest the Basal pump axis may go (M203 in config.g): the board holds every move to this, and homing too. Generate and send the config after changing it.">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding BasalMaxSpeed}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="Move Speed (mm/min)" ToolTip="The speed of the Basal pump axis's moves, sent with each move, so a change takes effect without sending the config. It cannot go above the Max Speed: a higher value runs at the Max Speed (Generate Config warns about it). Pumping and aspirating use their own speeds.">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="100" MinValue="1" MaxValue="100000" EditValue="{Binding BasalMoveSpeed}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Acceleration (mm/s²)" ToolTip="Acceleration of the Basal pump axis (M201).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding BasalAcceleration}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Max Speed Change (mm/min)" ToolTip="Maximum instantaneous speed change (jerk) of the Basal pump axis (M566).">
                                        <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="0" MaxValue="100000" EditValue="{Binding BasalMaxInstantaneousSpeedChange}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Direction" ToolTip="Direction the Basal axis motor turns for positive movement. Change this if the axis moves the wrong way.">
                                        <dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type control:Direction}}" EditValue="{Binding BasalDirection}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Style="{StaticResource ConfigSetting}" Label="Endstop Location" ToolTip="Which end of the Basal axis travel its endstop switch is at (M574 in config.g). Homing moves towards this end, then backs off 5 mm and homes again slowly; once homed the axis is at 0 (Low End) or at the top of its travel (High End). If homing heads the wrong way although this is right, change Direction (above) instead. Generate and send the config after changing it.">
                                        <dxe:ComboBoxEdit IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type control:EndstopLocation}}" EditValue="{Binding BasalEndstopLocation}" />
                                    </dxlc:LayoutItem>
                                </dxlc:LayoutGroup>
                            </dxlc:FlowLayoutControl>
                        </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </dx:DXTabItem>
            <dx:DXTabItem Header="Assay Timing" local:SettingsControl.Note="How long each stage of an assay lasts: incubation, mixing, the interval between readings, how long a sample stays in each solution, and the short pauses before aspirating and before a sensor reading.">
                <dxlc:LayoutControl Orientation="Horizontal">
                    <dxlc:LayoutGroup View="GroupBox" Header="Assay Timing (ms)" Orientation="Vertical">
                        <dxlc:LayoutItem Label="Basal Media Incubation (ms)" ToolTip="Milliseconds sample stays in Basal media incubation">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding BasalIncubationTimerPeriod}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="NADH-Basal Mixing Period (ms)" ToolTip="Milliseconds to wait for NADH to mix with Basal Media">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding NadhReading1TimerPeriod}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="NADH Readings Interval (ms)" ToolTip="Milliseconds between NADH readings">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding NadhReadingsTimerPeriod}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="NADH Timer Period (ms)" ToolTip="Milliseconds sample stays in NADH solution">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding NadhIncubationDwell}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="KOH Timer Period (ms)" ToolTip="Milliseconds sample stays in KOH solution">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding KohTimerPeriod}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="DNA Reagent Timer Period (ms)" ToolTip="Milliseconds sample stays in DNA reagent">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding DnaTimerPeriod}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Standards Establishment Period (seconds)" ToolTip="Milliseconds taken for establishing standards">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding StandardsProcessingDwell}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Aspiration Dwell (ms)" ToolTip="Milliseconds to wait after lowering the aspiration needle into the sample">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding AspirationDwell}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Sensor Read Pause (ms)" ToolTip="Milliseconds to wait before taking a DNA or NADH sensor reading">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="144000000" EditValue="{Binding SensorReadDwell}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </dx:DXTabItem>
            <dx:DXTabItem Header="Sterilization" local:SettingsControl.Note="How long the sample trays are sterilized with UV light, and where the table moves to for it.">
                <dxlc:LayoutControl Orientation="Horizontal">
                    <dxlc:LayoutGroup View="GroupBox" Header="Sample Tray Sterilization" Orientation="Vertical">
                        <dxlc:LayoutItem Label="Tray Sterilization Time (seconds)" ToolTip="Number of seconds tray will be UV sterilized">
                            <dxe:SpinEdit IsFloatValue="False" Increment="1" MinValue="0" MaxValue="60000" EditValue="{Binding TraySterilizationTime}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem LabelPosition="Top" Label="Tray Sterilization Location" ToolTip="Platform coordinates (mm x mm) of the location at which sample trays are sterilized">
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem LabelPosition="Left" Label="X">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding TraySterilizationLocationX}" />
                                </dxlc:LayoutItem>
                                <dxlc:LayoutItem LabelPosition="Left" Label="Y">
                                    <dxe:SpinEdit IsFloatValue="True" Increment="1" MinValue="0" MaxValue="1000" EditValue="{Binding TraySterilizationLocationY}" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </dx:DXTabItem>
            <dx:DXTabItem Header="Command Timeouts" local:SettingsControl.Note="How long Effani waits for the controller board to finish each kind of command before it gives up and reports an error. Slow operations such as homing have their own, longer timeouts.">
                <dxlc:LayoutControl Orientation="Horizontal">
                    <dxlc:LayoutGroup View="GroupBox" Header="Command Timeouts (seconds)" Orientation="Vertical">
                        <dxlc:LayoutItem Label="General" ToolTip="How long to wait for the controller board to report that it has finished a command before giving up on it (an error is logged and the next command runs). Used for every command that has no longer timeout below; the longer timeouts are never shorter than this.">
                            <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="1" MaxValue="86400" EditValue="{Binding BoardReadyTimeoutSeconds}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Home One Axis" ToolTip="Homing one axis. The table axes are the slowest: the full 505 mm of travel at the coarse homing speed (600 mm/min is about 50 s), plus the back-off and the fine pass. Lower homing speeds need more time.">
                            <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="1" MaxValue="86400" EditValue="{Binding HomeAxisTimeoutSeconds}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Home All Axes" ToolTip="Homing every axis one after another (G28): both table axes, the aspirate needle and the four pumps. About 135 s at the default homing speeds.">
                            <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="1" MaxValue="86400" EditValue="{Binding HomeAllTimeoutSeconds}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Moves" ToolTip="Moving the table or an axis, including aligning wells and moving to starting positions. A full 500 mm table move at 4000 mm/min is about 8 s.">
                            <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="1" MaxValue="86400" EditValue="{Binding MoveTimeoutSeconds}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Fluid Emission" ToolTip="A pump emitting fluid, including priming. The syringe moves slowly (Fluid Syringe Speed, 5 mm/min by default), so priming 1000 μl of DNA reagent or basal media takes about 18 s. The emission dwell is added automatically if it is longer.">
                            <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="1" MaxValue="86400" EditValue="{Binding FluidEmissionTimeoutSeconds}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Aspirate" ToolTip="The aspiration needle moving down to the plate and back. 90 mm at the 200 mm/min positioning speed is about 27 s. The aspiration dwell is added automatically if it is longer.">
                            <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="1" MaxValue="86400" EditValue="{Binding AspirateTimeoutSeconds}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Apply Config" ToolTip="Running config.g on the board. It waits 4 s for the expansion boards and then sets up WiFi.">
                            <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="1" MaxValue="86400" EditValue="{Binding ApplyConfigTimeoutSeconds}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="WiFi" ToolTip="Switching WiFi on or off, or setting the network. Starting the WiFi module can take several seconds.">
                            <dxe:SpinEdit IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="1" MaxValue="86400" EditValue="{Binding WifiTimeoutSeconds}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </dx:DXTabItem>
            <dx:DXTabItem Header="Connectivity" local:SettingsControl.Note="The Effani online account that assay results are uploaded to, and the WiFi network the controller board joins.">
                <dxlc:LayoutControl Orientation="Horizontal">
                    <dxlc:LayoutGroup View="GroupBox" Header="Connectivity" local:SettingsControl.Note="The address of the Effani online service and the account used to upload assay results to it." Orientation="Vertical">
                        <dxlc:LayoutItem Label="Effani API URL" ToolTip="Internet location of the Effani API endpoint.">
                            <dxe:TextEdit MinWidth="300" EditValue="{Binding EffaniApiUrl}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Effani Username" ToolTip="Username (email address) of your Effani account.">
                            <dxe:TextEdit MinWidth="300" EditValue="{Binding EffaniUsername}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Effani Password" ToolTip="Password of your Effani account.">
                            <dxe:PasswordBoxEdit ShowPasswordButtonVisibility="Auto" MinWidth="300" EditValue="{Binding EffaniPassword}"  />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup View="GroupBox" Header="Controller WiFi" local:SettingsControl.Note="The WiFi network the controller board connects to: its name, how it signs in, and the username and password. Send WiFi Settings sends them to the board." Orientation="Vertical">
                        <dxlc:LayoutItem Label="WiFi SSID" ToolTip="Name of the WiFi network the controller board is configured with (M587).">
                            <dxe:TextEdit MinWidth="300" EditValue="{Binding WifiSsid}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="Authentication" ToolTip="Password only (WPA2-PSK), or WPA2-Enterprise with a username and password (EAP-PEAP-MSCHAPv2 or EAP-TTLS-MSCHAPv2). Enterprise is experimental and needs RRF 3.5.1 or later with WiFi module firmware 2.1.0 or later (M587 X).">
                            <dxe:ComboBoxEdit MinWidth="300" MaxWidth="300" IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type control:WifiAuthentication}}" EditValue="{Binding WifiAuthentication}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="WiFi Username" ToolTip="Username for WPA2-Enterprise networks (M587 U). Not used with password-only authentication.">
                            <dxe:TextEdit MinWidth="300" EditValue="{Binding WifiUsername}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="WiFi Password" ToolTip="Password of the WiFi network the controller board is configured with (M587). Stored as plain text.">
                            <dxe:PasswordBoxEdit ShowPasswordButtonVisibility="Auto" MinWidth="300" EditValue="{Binding WifiPassword}" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <StackPanel Orientation="Horizontal">
                                <dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="0,0,5,0" Content="Enable Wifi on Controller" ToolTip="Turns the controller's WiFi on (M552 S1)."
                                                 Command="{Binding Path=DataContext.EnableWifiCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsControl}}}" />
                                <dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Content="Disable Wifi on Controller" ToolTip="Turns the controller's WiFi off (M552 S0)."
                                                 Command="{Binding Path=DataContext.DisableWifiCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsControl}}}" />
                            </StackPanel>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" HorizontalAlignment="Left" Content="Send WiFi Settings" ToolTip="Sends M587 to the controller board with the authentication, SSID, username and password above."
                                             Command="{Binding Path=DataContext.SetWifiCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsControl}}}" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </DockPanel>
</UserControl>
