<dx:ThemedWindow 
    x:Class="Effani.Device.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
	xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
    xmlns:local="clr-namespace:Effani.Device.UI"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Effani" WindowStyle="None"
	WindowStartupLocation="CenterScreen" 
	WindowState="Maximized"
	Height="800" Width="1000">
	<dx:ThemedWindow.Resources>
		<Style TargetType="{x:Type Border}">
			<Setter Property="Background" Value="White" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="BorderThickness" Value="3" />
			<Setter Property="BorderBrush" Value="CornflowerBlue" />
			<Setter Property="Padding" Value="20" />
		</Style>
		<BooleanToVisibilityConverter x:Key="UpdateNoticeVisibility" />
    </dx:ThemedWindow.Resources>
	<Grid>
		<!-- the background image is on the whole window, so it shows through the transparent toolbar as well as behind the wizard -->
		<Grid.Background>
			<ImageBrush ImageSource="{DXBinding '!AllSamplesLoadedAndProcessing ? `Resources/effani_background.jpg` : null'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,1280,720" />
		</Grid.Background>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<!-- a toolbar of its own rather than title bar items, so the buttons can be big enough for a small touchscreen -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Background="Transparent">
			<dx:SimpleButton Command="{Binding ShowUploadCommand}" Background="Transparent" BorderThickness="0" Margin="4,4,4,4" MinWidth="84" MinHeight="76" ToolTip="Upload">
				<dx:SimpleButton.Content>
					<Image Width="52" Height="52" Source="{dx:DXImage 'SvgImages/Icon Builder/Weather_Cloudy.svg'}" />
				</dx:SimpleButton.Content>
			</dx:SimpleButton>
			<dx:SimpleButton Command="{Binding ShowToolsCommand}" Background="Transparent" BorderThickness="0" Margin="4,4,4,4" MinWidth="84" MinHeight="76" ToolTip="Tools">
				<dx:SimpleButton.Content>
					<Image Width="52" Height="52" Source="{dx:DXImage 'SvgImages/Icon Builder/Actions_Settings.svg'}" />
				</dx:SimpleButton.Content>
			</dx:SimpleButton>
		</StackPanel>
		<!-- a newer version of the program was found (looked for each time the program or Tools opens) and has not been ignored -->
		<Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,8,0,8" Padding="18,6,8,6" CornerRadius="6"
				Background="#FFF8E1" BorderBrush="#F9A825" BorderThickness="2"
				Visibility="{Binding IsBannerVisible, Source={x:Static local:UpdateWatch.Current}, Converter={StaticResource UpdateNoticeVisibility}}">
			<StackPanel Orientation="Horizontal">
				<TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding Message, Source={x:Static local:UpdateWatch.Current}}" />
				<dx:SimpleButton Margin="18,0,0,0" Padding="20,0,20,0" MinHeight="56" FontSize="20" CornerRadius="4" VerticalAlignment="Center" Content="See what's new" Click="WhatsNew_Click"
						ToolTip="Show the release notes of the new version, with the choice of installing it or ignoring it" />
			</StackPanel>
		</Border>
		<local:Wizard Grid.Row="1"></local:Wizard>
		<!-- turns typing with the on-screen keyboard on and off; the same button is in the lower right corner of every window -->
		<local:OnScreenInputToggle Grid.Row="0" Grid.RowSpan="2" />
	</Grid>
</dx:ThemedWindow>
