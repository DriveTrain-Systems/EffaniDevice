<dx:ThemedWindow 
    x:Class="Effani.Device.UI.UtilitiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
	xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
    xmlns:control="clr-namespace:Drivetrain.Robotics.Control;assembly=Drivetrain.Robotics.Control"
    xmlns:local="clr-namespace:Effani.Device.UI"
    xmlns:sys="clr-namespace:System;assembly=mscorlib" d:DataContext="{d:DesignInstance Type=local:UtilitiesViewModel}"
	Title="Tools" WindowStyle="None" FontSize="16" 
	WindowState="Maximized"
	WindowStartupLocation="CenterScreen" 
    mc:Ignorable="d" d:DesignHeight="1024" d:DesignWidth="1980">
	<dx:ThemedWindow.Resources>
		<ResourceDictionary>
			<Style TargetType="dxlc:LayoutItemLabel">
				<Setter Property="FontWeight" Value="Normal"/>
			</Style>
			<Style TargetType="dxlc:LayoutItem">
				<Setter Property="HorizontalAlignment" Value="Right"/>
				<Setter Property="LabelPosition" Value="Left"/>
				<Setter Property="LabelHorizontalAlignment" Value="Stretch"/>
			</Style>
			<!-- touchscreen-sized buttons -->
			<Style TargetType="dx:SimpleButton">
				<Setter Property="MinHeight" Value="52" />
				<Setter Property="MinWidth" Value="52" />
				<Setter Property="FontSize" Value="16" />
			</Style>
			<Style TargetType="dxe:TextEdit"><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="16"/></Style>
				<Style x:Key="NoScrollListBox" TargetType="ListBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate></Setter.Value></Setter></Style>
				<local:PassThroughConverter x:Key="PassThroughConverter"/>
			<local:AxisPositionConverter x:Key="AxisPositionConverter"/>
			<local:AxisPositionValueConverter x:Key="AxisPositionValueConverter"/>
			<local:AxisHomedConverter x:Key="AxisHomedConverter"/>
			<local:AxisHomedBrushConverter x:Key="AxisHomedBrushConverter"/>
			<local:AxisHomedVisibilityConverter x:Key="AxisHomedVisible" />
			<local:AxisHomedVisibilityConverter x:Key="AxisNotHomedVisible" WhenHomed="False" />
			<!-- the position slider of an axis, with a handle big enough for a finger. The pointer is handled in the code-behind
			     (AxisSlider_...), not by the handle, so the template is only what is seen. -->
			<Style x:Key="AxisSlider" TargetType="Slider">
				<Setter Property="Focusable" Value="False" />
				<Setter Property="Height" Value="44" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Slider">
							<Grid Background="Transparent">
								<Border Height="8" CornerRadius="4" Background="#CFCFCF" VerticalAlignment="Center" />
								<Track x:Name="PART_Track">
									<Track.Thumb>
										<Thumb x:Name="handle" Width="24" Height="38">
											<Thumb.Template>
												<ControlTemplate TargetType="Thumb">
													<Border CornerRadius="5" Background="#2F7FD0" BorderBrush="#1F5FA5" BorderThickness="1">
														<!-- two grip lines -->
														<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
															<Border Width="2" Height="16" Margin="2,0,2,0" CornerRadius="1" Background="#D9FFFFFF" />
															<Border Width="2" Height="16" Margin="2,0,2,0" CornerRadius="1" Background="#D9FFFFFF" />
														</StackPanel>
													</Border>
												</ControlTemplate>
											</Thumb.Template>
										</Thumb>
									</Track.Thumb>
								</Track>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="IsEnabled" Value="False">
									<Setter TargetName="handle" Property="Opacity" Value="0.4" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<!-- an on/off switch: blue with the knob on the right when on, grey with the knob on the left when off -->
			<Style x:Key="UvSwitch" TargetType="ToggleButton">
				<Setter Property="Width" Value="72" />
				<Setter Property="Height" Value="38" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ToggleButton">
							<Border x:Name="Track" CornerRadius="19" Background="#BDBDBD" BorderBrush="#9E9E9E" BorderThickness="1">
								<Ellipse x:Name="Thumb" Width="30" Height="30" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsChecked" Value="True">
									<Setter TargetName="Track" Property="Background" Value="#1E88E5" />
									<Setter TargetName="Track" Property="BorderBrush" Value="#1565C0" />
									<Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
									<Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
								</Trigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Track" Property="BorderThickness" Value="2" />
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter TargetName="Track" Property="Opacity" Value="0.5" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<!-- touchscreen-sized tab headers; this also reaches the tabs of the settings control shown in this window. The size is set in the
			     header template rather than with FontSize on the tab, which the content of the tab would inherit -->
			<Style TargetType="dx:DXTabItem">
				<Setter Property="MinHeight" Value="56" />
				<Setter Property="MinWidth" Value="96" />
				<Setter Property="HeaderTemplate">
					<Setter.Value>
						<DataTemplate>
							<TextBlock Text="{Binding}" FontSize="18" Margin="12,8,12,8" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="TabItemStyle" TargetType="dx:DXTabItem" >
				<Setter Property="Header" Value="{Binding}"/>
				<Setter Property="Content" Value="{Binding}"/>
			</Style>
			<!-- spin arrows wide enough to hit with a finger -->
			<Style TargetType="dxe:SpinButton"><Setter Property="MinWidth" Value="40"/></Style>
			<Style TargetType="dxe:SpinEdit" >
				<Setter Property="MaxWidth" Value="120"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="16"/>
				<Setter Property="MinWidth" Value="110"/>
			</Style>
			<Style TargetType="dxlc:GroupBox">
				<Setter Property="FontSize" Value="15"/>
				<Setter Property="FontWeight" Value="Bold"/>
				<Setter Property="TitleBackground" Value="Gray"/>
				<Setter Property="TitleForeground" Value="White"/>
				<Setter Property="VerticalAlignment" Value="Stretch"/>
			</Style>
			<Style TargetType="dxlc:LayoutGroup">
				<Setter Property="ItemSpace" Value="10"/>
			</Style>
			<DataTemplate x:Key="TabItemHeaderTemplate">
				<TextBlock x:Name="label" Padding="5" Margin="3" Text="{Binding Label}" />
			</DataTemplate>
			<DataTemplate x:Key="TabItemContentTemplate">
				<GroupBox Header="{Binding Label}">
					<GroupBox.HeaderTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding}" FontSize="22" FontWeight="Bold" Margin="0,1,5,0" />
						</DataTemplate>
					</GroupBox.HeaderTemplate>
					<StackPanel Orientation="Horizontal">
						<StackPanel Orientation="Vertical">
							<TextBlock Width="200" x:Name="label" FontSize="15" Margin="0,1,5,0">
								<TextBlock.Text>
									<MultiBinding StringFormat="{}Axis {0}, {1}">
										<Binding Path="Designation" />
										<Binding Path="DriverPort" />
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
							<TextBlock Width="200" FontSize="15" Margin="0,1,5,0">
								<TextBlock.Text>
									<MultiBinding StringFormat="{}{0}">
										<Binding Path="Driver.Endstop.SensorPort" />
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
							<TextBlock Width="200" FontSize="15" FontWeight="SemiBold" Margin="0,1,5,0" ToolTip="Where the board says the axis is, read after every move and home">
								<TextBlock.Text>
									<MultiBinding Converter="{StaticResource AxisPositionConverter}">
										<Binding Path="Designation" />
										<Binding ElementName="axesList" Path="DataContext.Positions" />
										<Binding ElementName="axesList" Path="DataContext.Homed" />
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
						</StackPanel>
						<StackPanel Orientation="Vertical">
					</StackPanel>
						<StackPanel>
							<StackPanel Orientation="Horizontal">
								<!-- an axis that is not homed cannot be moved: until it is, the row has this button and nothing else -->
								<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=axesList, Path=DataContext.HomeCommand}" CommandParameter="{Binding}" Content="Home to enable axis movement"
										ToolTip="Home this axis. Its slider, jog buttons and commands take this button's place once it is homed.">
									<dx:SimpleButton.Background>
										<MultiBinding Converter="{StaticResource AxisHomedBrushConverter}">
											<Binding Path="Designation" />
											<Binding ElementName="axesList" Path="DataContext.Homed" />
										</MultiBinding>
									</dx:SimpleButton.Background>
									<dx:SimpleButton.Visibility>
										<MultiBinding Converter="{StaticResource AxisNotHomedVisible}">
											<Binding Path="Designation" />
											<Binding ElementName="axesList" Path="DataContext.Homed" />
										</MultiBinding>
									</dx:SimpleButton.Visibility>
								</dx:SimpleButton>
									<!-- once the axis is homed: its jog buttons and slider, then the list of its other commands -->
									<StackPanel Orientation="Horizontal">
										<StackPanel.Visibility>
											<MultiBinding Converter="{StaticResource AxisHomedVisible}">
												<Binding Path="Designation" />
												<Binding ElementName="axesList" Path="DataContext.Homed" />
											</MultiBinding>
										</StackPanel.Visibility>
									<!-- jog back: small moves of the axis from where it is, 5 mm and 1 mm, beside the slider that shows where that is -->
									<dx:SimpleButton CornerRadius="3" Padding="0" MinWidth="50" MinHeight="52" Margin="8,4,2,4" FontSize="16" VerticalAlignment="Center" Content="&#8722;5"
											Command="{Binding ElementName=axesList, Path=DataContext.MoveRapidCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="Jog: move this axis 5 mm back, toward 0. Available once the axis is homed.">
										<dx:SimpleButton.IsEnabled>
											<MultiBinding Converter="{StaticResource AxisHomedConverter}">
												<Binding Path="Designation" />
												<Binding ElementName="axesList" Path="DataContext.Homed" />
											</MultiBinding>
										</dx:SimpleButton.IsEnabled>
										<Button.CommandParameter>
											<MultiBinding Converter="{StaticResource PassThroughConverter}">
												<Binding/>
												<Binding>
													<Binding.Source>
														<sys:Single>-5</sys:Single>
													</Binding.Source>
												</Binding>
											</MultiBinding>
										</Button.CommandParameter>
									</dx:SimpleButton>
									<dx:SimpleButton CornerRadius="3" Padding="0" MinWidth="50" MinHeight="52" Margin="2,4,0,4" FontSize="16" VerticalAlignment="Center" Content="&#8722;1"
											Command="{Binding ElementName=axesList, Path=DataContext.MoveRapidCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="Jog: move this axis 1 mm back, toward 0. Available once the axis is homed.">
										<dx:SimpleButton.IsEnabled>
											<MultiBinding Converter="{StaticResource AxisHomedConverter}">
												<Binding Path="Designation" />
												<Binding ElementName="axesList" Path="DataContext.Homed" />
											</MultiBinding>
										</dx:SimpleButton.IsEnabled>
										<Button.CommandParameter>
											<MultiBinding Converter="{StaticResource PassThroughConverter}">
												<Binding/>
												<Binding>
													<Binding.Source>
														<sys:Single>-1</sys:Single>
													</Binding.Source>
												</Binding>
											</MultiBinding>
										</Button.CommandParameter>
									</dx:SimpleButton>
									<!-- the axis's position along its travel: dragging the handle moves the axis there when it is let go, a tap opens a window to
									     type a position. Only positions on the travel can be chosen. The handling is in the code-behind (AxisSlider_...), which
									     takes the touch itself so that the list's touch scrolling does not swallow a drag. -->
									<Border Margin="4,4,4,4" Padding="10,0,10,0" MinHeight="52" CornerRadius="3" BorderThickness="1" BorderBrush="#C8C8C8" Background="Transparent" VerticalAlignment="Center"
											ToolTipService.ShowOnDisabled="True" ToolTip="Drag the handle to move this axis to a position, or tap to type one. Available once the axis is homed.">
										<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
											<TextBlock VerticalAlignment="Center" FontSize="15" Opacity="0.75" MinWidth="14" TextAlignment="Right" Text="{Binding Minimum}" Margin="0,0,8,0" />
											<Slider Style="{StaticResource AxisSlider}" Width="288" VerticalAlignment="Center" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
													Stylus.IsPressAndHoldEnabled="False"
													PreviewMouseLeftButtonDown="AxisSlider_MouseDown" PreviewMouseMove="AxisSlider_MouseMove" PreviewMouseLeftButtonUp="AxisSlider_MouseUp" LostMouseCapture="AxisSlider_LostCapture"
													PreviewTouchDown="AxisSlider_TouchDown" PreviewTouchMove="AxisSlider_TouchMove" PreviewTouchUp="AxisSlider_TouchUp" LostTouchCapture="AxisSlider_LostCapture">
												<Slider.Value>
													<MultiBinding Converter="{StaticResource AxisPositionValueConverter}" Mode="OneWay">
														<Binding Path="Designation" />
														<Binding ElementName="axesList" Path="DataContext.Positions" />
													</MultiBinding>
												</Slider.Value>
												<Slider.IsEnabled>
													<MultiBinding Converter="{StaticResource AxisHomedConverter}">
														<Binding Path="Designation" />
														<Binding ElementName="axesList" Path="DataContext.Homed" />
													</MultiBinding>
												</Slider.IsEnabled>
											</Slider>
											<TextBlock VerticalAlignment="Center" FontSize="15" Opacity="0.75" MinWidth="64" Text="{Binding Maximum, StringFormat={}{0} mm}" Margin="8,0,0,0" />
											<!-- where the axis will go, shown while the handle is being dragged -->
											<TextBlock Tag="target" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" MinWidth="64" Margin="12,0,0,0" />
										</StackPanel>
									</Border>
									<!-- jog forward: the same small moves on the other side of the slider -->
									<dx:SimpleButton CornerRadius="3" Padding="0" MinWidth="50" MinHeight="52" Margin="0,4,2,4" FontSize="16" VerticalAlignment="Center" Content="+1"
											Command="{Binding ElementName=axesList, Path=DataContext.MoveRapidCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="Jog: move this axis 1 mm forward, away from 0. Available once the axis is homed.">
										<dx:SimpleButton.IsEnabled>
											<MultiBinding Converter="{StaticResource AxisHomedConverter}">
												<Binding Path="Designation" />
												<Binding ElementName="axesList" Path="DataContext.Homed" />
											</MultiBinding>
										</dx:SimpleButton.IsEnabled>
										<Button.CommandParameter>
											<MultiBinding Converter="{StaticResource PassThroughConverter}">
												<Binding/>
												<Binding>
													<Binding.Source>
														<sys:Single>1</sys:Single>
													</Binding.Source>
												</Binding>
											</MultiBinding>
										</Button.CommandParameter>
									</dx:SimpleButton>
									<dx:SimpleButton CornerRadius="3" Padding="0" MinWidth="50" MinHeight="52" Margin="2,4,4,4" FontSize="16" VerticalAlignment="Center" Content="+5"
											Command="{Binding ElementName=axesList, Path=DataContext.MoveRapidCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="Jog: move this axis 5 mm forward, away from 0. Available once the axis is homed.">
										<dx:SimpleButton.IsEnabled>
											<MultiBinding Converter="{StaticResource AxisHomedConverter}">
												<Binding Path="Designation" />
												<Binding ElementName="axesList" Path="DataContext.Homed" />
											</MultiBinding>
										</dx:SimpleButton.IsEnabled>
										<Button.CommandParameter>
											<MultiBinding Converter="{StaticResource PassThroughConverter}">
												<Binding/>
												<Binding>
													<Binding.Source>
														<sys:Single>5</sys:Single>
													</Binding.Source>
												</Binding>
											</MultiBinding>
										</Button.CommandParameter>
									</dx:SimpleButton>
									<!-- every other move of the axis, and homing it again: to its start position, to a well, or by a distance. The list stays open after a
									     move to a well, so the wells can be stepped through; touching anywhere else closes it. -->
									<dx:DropDownButton CornerRadius="3" Padding="16,12,16,12" Margin="4" MinHeight="52" FontSize="16" Content="Commands..."
											ToolTip="More for this axis: home it again, move it to its start position, to a well, or by a distance.">
										<Border Padding="8">
											<StackPanel>
												<StackPanel Orientation="Horizontal">
												<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=axesList, Path=DataContext.HomeCommand}" CommandParameter="{Binding}" Content="Home"
														ToolTip="Home this axis again." />
												<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=axesList, Path=DataContext.MoveToStartCommand}" CommandParameter="{Binding}" Content="Move To Start">
													<dx:SimpleButton.IsEnabled>
														<MultiBinding Converter="{StaticResource AxisHomedConverter}">
															<Binding Path="Designation" />
															<Binding ElementName="axesList" Path="DataContext.Homed" />
														</MultiBinding>
													</dx:SimpleButton.IsEnabled>
												</dx:SimpleButton>
												<!-- a move by a distance: asks how far and which way (MoveBy_Click, MoveByView) -->
												<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Click="MoveBy_Click" Content="Move..."
														ToolTipService.ShowOnDisabled="True" ToolTip="Move this axis by a distance you type, back or forward. Available once the axis is homed.">
													<dx:SimpleButton.IsEnabled>
														<MultiBinding Converter="{StaticResource AxisHomedConverter}">
															<Binding Path="Designation" />
															<Binding ElementName="axesList" Path="DataContext.Homed" />
														</MultiBinding>
													</dx:SimpleButton.IsEnabled>
												</dx:SimpleButton>
												<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=axesList, Path=DataContext.AlignToFirstWellCommand}" CommandParameter="{Binding}" Content="Align First Well" Visibility="{DXBinding '@DataContext.GetType() == typeof($control:TableAxis) ? $Visibility.Collapsed : $Visibility.Visible'}">
													<dx:SimpleButton.IsEnabled>
														<MultiBinding Converter="{StaticResource AxisHomedConverter}" ConverterParameter="table">
															<Binding Path="Designation" />
															<Binding ElementName="axesList" Path="DataContext.Homed" />
														</MultiBinding>
													</dx:SimpleButton.IsEnabled>
												</dx:SimpleButton>
												<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=axesList, Path=DataContext.AlignToNextWellCommand}" CommandParameter="{Binding}" Content="Align Next Well" Visibility="{DXBinding '@DataContext.GetType() == typeof($control:TableAxis) ? $Visibility.Collapsed : $Visibility.Visible'}">
													<dx:SimpleButton.IsEnabled>
														<MultiBinding Converter="{StaticResource AxisHomedConverter}" ConverterParameter="table">
															<Binding Path="Designation" />
															<Binding ElementName="axesList" Path="DataContext.Homed" />
														</MultiBinding>
													</dx:SimpleButton.IsEnabled>
												</dx:SimpleButton>
												<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=axesList, Path=DataContext.AlignToLastWellCommand}" CommandParameter="{Binding}" Content="Align Last Well" Visibility="{DXBinding '@DataContext.GetType() == typeof($control:TableAxis) ? $Visibility.Collapsed : $Visibility.Visible'}">
													<dx:SimpleButton.IsEnabled>
														<MultiBinding Converter="{StaticResource AxisHomedConverter}" ConverterParameter="table">
															<Binding Path="Designation" />
															<Binding ElementName="axesList" Path="DataContext.Homed" />
														</MultiBinding>
													</dx:SimpleButton.IsEnabled>
												</dx:SimpleButton>
												<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=axesList, Path=DataContext.ReprimeIfNeededCommand}" CommandParameter="{Binding}" 
														Visibility="{DXBinding '@DataContext.GetType() == typeof($control:FluidAxis) ? $Visibility.Visible : $Visibility.Collapsed'}" Content="Reprime If Needed">
													<dx:SimpleButton.IsEnabled>
														<MultiBinding Converter="{StaticResource AxisHomedConverter}">
															<Binding Path="Designation" />
															<Binding ElementName="axesList" Path="DataContext.Homed" />
														</MultiBinding>
													</dx:SimpleButton.IsEnabled>
												</dx:SimpleButton>
												<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=axesList, Path=DataContext.AspirateCommand}" CommandParameter="{Binding}" Content="Aspirate"
														Visibility="{DXBinding '@DataContext.GetType() == typeof($control:AspirateZAxis) ? $Visibility.Visible : $Visibility.Collapsed'}"
														ToolTipService.ShowOnDisabled="True" ToolTip="Aspirate the KOH aspiration volume with the needle (the same as Aspirate in the Actuators group); available once the needle is homed">
													<dx:SimpleButton.IsEnabled>
														<MultiBinding Converter="{StaticResource AxisHomedConverter}">
															<Binding Path="Designation" />
															<Binding ElementName="axesList" Path="DataContext.Homed" />
														</MultiBinding>
													</dx:SimpleButton.IsEnabled>
												</dx:SimpleButton>
												<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=axesList, Path=DataContext.EmitFluidCommand}" CommandParameter="{Binding}"
														Visibility="{DXBinding '@DataContext.GetType() == typeof($control:FluidAxis) ? $Visibility.Visible : $Visibility.Collapsed'}">
													<dx:SimpleButton.IsEnabled>
														<MultiBinding Converter="{StaticResource AxisHomedConverter}">
															<Binding Path="Designation" />
															<Binding ElementName="axesList" Path="DataContext.Homed" />
														</MultiBinding>
													</dx:SimpleButton.IsEnabled>
													<dx:SimpleButton.Content>
														<StackPanel Orientation="Horizontal">
															<TextBlock Text="Dispense Fluid" />
															<dxe:SpinEdit Width="110" ShowBorder="False" MaxHeight="60" EditValue="{Binding ElementName=axesList, Path=DataContext.EmitFluidVolume, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" Text="200"
																		EditValueType="{x:Type sys:Int32}" HorizontalContentAlignment="Right" IsFloatValue="False" Mask="d0" AllowSpinOnMouseWheel="True" />
														</StackPanel>
													</dx:SimpleButton.Content>
												</dx:SimpleButton>
												</StackPanel>
											</StackPanel>
										</Border>
									</dx:DropDownButton>
									</StackPanel>
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</GroupBox>
			</DataTemplate>
			<DataTemplate x:Key="SensorContentTemplate">
				<StackPanel Orientation="Horizontal">
					<StackPanel Orientation="Vertical">
						<TextBlock Width="200" Text="{Binding Label}" FontSize="22" FontWeight="Bold" Margin="0,1,5,0" />
						<TextBlock Width="200" x:Name="label" FontSize="15" Margin="0,1,5,0">
							<TextBlock.Text>
								<MultiBinding StringFormat="{}S{0}, {1}">
									<Binding Path="SensorNumber" />
									<Binding Path="PortDesignation" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
						<TextBlock Width="200" FontSize="15" Margin="0,1,5,0">
							<TextBlock.Text>
								<MultiBinding StringFormat="{}{0},{1}">
									<Binding Path="Location.X" />
									<Binding Path="Location.Y" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
					</StackPanel>
					<StackPanel Orientation="Vertical">
						<StackPanel Orientation="Horizontal">
							<StackPanel Orientation="Horizontal" Margin="4,0,12,0" VerticalAlignment="Center" ToolTip="Switches the NADH laser. Shows whether the board reports it on; it updates after each switch."
									Visibility="{DXBinding '@DataContext.GetType() == typeof($control:NadhSensorSpec) ? $Visibility.Visible : $Visibility.Collapsed'}">
								<ToggleButton Style="{StaticResource UvSwitch}" IsChecked="{Binding ElementName=sensors, Path=DataContext.NadhLaserIsOn, Mode=TwoWay}" VerticalAlignment="Center" />
								<TextBlock Text="Laser" VerticalAlignment="Center" Margin="8,0,0,0" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" Margin="4,0,12,0" VerticalAlignment="Center" ToolTip="Switches the DNA laser. Shows whether the board reports it on; it updates after each switch."
									Visibility="{DXBinding '@DataContext.GetType() == typeof($control:DnaSensorSpec) ? $Visibility.Visible : $Visibility.Collapsed'}">
								<ToggleButton Style="{StaticResource UvSwitch}" IsChecked="{Binding ElementName=sensors, Path=DataContext.DnaLaserIsOn, Mode=TwoWay}" VerticalAlignment="Center" />
								<TextBlock Text="Laser" VerticalAlignment="Center" Margin="8,0,0,0" />
							</StackPanel>
							<!-- the caption carries the reading: "Read Sensor: 1234" once one has been taken from here ("…" while it is on its way) -->
							<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" MinWidth="230" Command="{Binding ElementName=sensors, Path=DataContext.ReadCommand}" CommandParameter="{Binding}"
									Content="{DXBinding '@DataContext.GetType() == typeof($control:DnaSensorSpec) ? @e(sensors).DataContext.DnaReadSensorText : @e(sensors).DataContext.NadhReadSensorText'}"
									ToolTip="Takes a reading from this sensor. The reading is shown on this button and in Messages." />
							<!-- the moves that bring a well under this sensor, in a list like the one each axis has. The list stays open after a move, so the
							     tray can be stepped from well to well; touching anywhere else closes it. -->
							<dx:DropDownButton CornerRadius="3" Padding="16,12,16,12" Margin="4" MinHeight="52" FontSize="16" Content="Commands..."
									ToolTip="Moves the tray to bring a well under this sensor.">
								<Border Padding="8">
									<StackPanel Orientation="Horizontal">
										<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=sensors, Path=DataContext.AlignToFirstWellCommand}" CommandParameter="{Binding}" Content="Align First Well" />
										<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=sensors, Path=DataContext.AlignToNextWellCommand}" CommandParameter="{Binding}" Content="Align Next Well" />
										<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding ElementName=sensors, Path=DataContext.AlignToLastWellCommand}" CommandParameter="{Binding}" Content="Align Last Well" />
									</StackPanel>
								</Border>
							</dx:DropDownButton>
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</DataTemplate>
		</ResourceDictionary>
	</dx:ThemedWindow.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>
		<dx:DXTabControl Grid.Column="0" SelectedIndex="0">
			<!-- the window has no title bar: this button, in its upper left corner before the tabs, goes back to the main screen -->
			<dx:DXTabControl.ControlBoxLeftTemplate>
				<DataTemplate>
					<dx:SimpleButton Margin="6,4,14,4" Padding="24,0,28,0" MinHeight="54" VerticalAlignment="Center" CornerRadius="3" FontSize="18" Content="&#8592;  Back"
							ToolTip="Close Tools and go back to the main screen" Click="Close_Click" />
				</DataTemplate>
			</dx:DXTabControl.ControlBoxLeftTemplate>
			<!-- at the other end of the row of tabs: the software version, checking for updates and what the check reported -->
			<dx:DXTabControl.ControlBoxRightTemplate>
				<DataTemplate>
					<StackPanel Orientation="Horizontal" Margin="14,4,6,4" VerticalAlignment="Center"
							DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=dx:DXTabControl}}">
						<TextBlock VerticalAlignment="Center" Margin="0,0,18,0" MaxWidth="460" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding UpdateStatus}"
								Visibility="{DXBinding 'UpdateStatus == null or UpdateStatus == `` ? `Collapsed` : `Visible`'}" />
						<TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Text="Software" />
						<TextBlock VerticalAlignment="Center" Opacity="0.7" Margin="0,0,14,0" Text="{Binding SoftwareVersion, StringFormat=Version {0}}" />
						<dx:SimpleButton CornerRadius="3" Padding="16,0,16,0" MinHeight="54" VerticalAlignment="Center" Command="{Binding CheckForUpdatesCommand}" Content="Check for Updates"
								ToolTipService.ShowOnDisabled="True" ToolTip="{DXBinding 'IsAssayRunning ? `Not available while an assay is running` : `Check whether a newer version of this software is available`'}" />
					</StackPanel>
				</DataTemplate>
			</dx:DXTabControl.ControlBoxRightTemplate>
			<dx:DXTabItem Header="Component Control">
				<DockPanel LastChildFill="True">
						<dxlc:LayoutControl DockPanel.Dock="Left" Orientation="Vertical">
							<dxlc:LayoutGroup View="GroupBox" Orientation="Vertical" VerticalAlignment="Top">
								<dxlc:LayoutGroup.GroupBoxStyle>
									<Style TargetType="dxlc:GroupBox">
										<Setter Property="TitleVisibility" Value="Collapsed" />
									</Style>
								</dxlc:LayoutGroup.GroupBoxStyle>
								<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding HomeAllCommand}" Content="Home All"
										ToolTip="Home every axis. Yellow until all the axes are homed, green once they are.">
									<dx:SimpleButton.Background>
										<MultiBinding Converter="{StaticResource AxisHomedBrushConverter}" ConverterParameter="all">
											<Binding Path="Homed" />
										</MultiBinding>
									</dx:SimpleButton.Background>
								</dx:SimpleButton>
								<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding AlignForWasteCommand}" Content="Align For Waste" ToolTipService.ShowOnDisabled="True"
										ToolTip="Moves the table: available once Table X and Y are homed.">
									<dx:SimpleButton.IsEnabled>
										<MultiBinding Converter="{StaticResource AxisHomedConverter}" ConverterParameter="table">
											<Binding Path="Homed" />
										</MultiBinding>
									</dx:SimpleButton.IsEnabled>
								</dx:SimpleButton>
								<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding AlignForTrayLoadingCommand}" Content="Align For Tray Loading" ToolTipService.ShowOnDisabled="True"
										ToolTip="Moves the table: available once Table X and Y are homed.">
									<dx:SimpleButton.IsEnabled>
										<MultiBinding Converter="{StaticResource AxisHomedConverter}" ConverterParameter="table">
											<Binding Path="Homed" />
										</MultiBinding>
									</dx:SimpleButton.IsEnabled>
								</dx:SimpleButton>
								<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding AlignForSterilizationCommand}" Content="Align For Sterilization" ToolTipService.ShowOnDisabled="True"
										ToolTip="Moves the table: available once Table X and Y are homed.">
									<dx:SimpleButton.IsEnabled>
										<MultiBinding Converter="{StaticResource AxisHomedConverter}" ConverterParameter="table">
											<Binding Path="Homed" />
										</MultiBinding>
									</dx:SimpleButton.IsEnabled>
								</dx:SimpleButton>
                                <dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="4" Command="{Binding PrimeFluidCommand}" Content="Prime Fluid" ToolTipService.ShowOnDisabled="True"
                                		ToolTip="Moves the four pumps: available once they are all homed.">
                                	<dx:SimpleButton.IsEnabled>
                                		<MultiBinding Converter="{StaticResource AxisHomedConverter}" ConverterParameter="DnaReagent,Koh,Nadh,Basal">
                                			<Binding Path="Homed" />
                                		</MultiBinding>
                                	</dx:SimpleButton.IsEnabled>
                                </dx:SimpleButton>
								<Separator Margin="3,6,3,3" Opacity="0.5" />
								<StackPanel Orientation="Horizontal" Margin="3" ToolTip="Switches the chamber UV light (output port 1). Shows whether the board reports it on; it updates after each switch.">
									<ToggleButton Style="{StaticResource UvSwitch}" IsChecked="{Binding ChamberUvIsOn, Mode=TwoWay}" VerticalAlignment="Center" />
									<TextBlock Text="Chamber UV" VerticalAlignment="Center" Margin="8,0,0,0" />
								</StackPanel>
								<StackPanel Orientation="Horizontal" Margin="3" ToolTip="Switches the tray UV light (output port 0). Shows whether the board reports it on; it updates after each switch.">
									<ToggleButton Style="{StaticResource UvSwitch}" IsChecked="{Binding TrayUvIsOn, Mode=TwoWay}" VerticalAlignment="Center" />
									<TextBlock Text="Tray UV" VerticalAlignment="Center" Margin="8,0,0,0" />
								</StackPanel>
							</dxlc:LayoutGroup>
						</dxlc:LayoutControl>
							<!-- scrolls vertically and horizontally, and by touch panning, when the axes and sensors do not fit the window -->
						<ScrollViewer DockPanel.Dock="Left" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PanningMode="Both">
						<StackPanel Orientation="Vertical">
							<ListBox x:Name="axesList" Style="{StaticResource NoScrollListBox}" BorderThickness="0" Background="Transparent" ItemsSource="{Binding Axes}" ItemTemplate="{StaticResource TabItemContentTemplate}"/>
							<ListBox x:Name="sensors" Style="{StaticResource NoScrollListBox}" BorderThickness="0" Background="Transparent" ItemsSource="{Binding Sensors}" ItemTemplate="{StaticResource SensorContentTemplate}"/>
						</StackPanel>
						</ScrollViewer>
				</DockPanel>
			</dx:DXTabItem>
			<dx:DXTabItem Header="Settings">
				<local:SettingsControl/>
			</dx:DXTabItem>
		</dx:DXTabControl>
		<!-- the commands panel: sending a command to the board, board and software management, the command queue and the messages.
		     It is beside the tabs rather than on one of them, so it stays in view whichever tab is open. -->
		<DockPanel Grid.Column="1" Margin="0,2,2,4">
			<Border Width="480" Padding="14,8,10,6">
				<DockPanel LastChildFill="True">
					<TextBlock DockPanel.Dock="Top" FontSize="22" FontWeight="Bold" Margin="0,0,0,10" Text="Commands" />
					<DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
						<dx:SimpleButton DockPanel.Dock="Right" CornerRadius="3" Padding="18,12,18,12" Margin="6,0,0,0" Command="{Binding SendCommand}" Content="Send" />
						<dxe:TextEdit CornerRadius="3" Padding="8,6,8,6" NullText="Command..." EditValue="{Binding SendCommandText, UpdateSourceTrigger=PropertyChanged}">
							<dxe:TextEdit.InputBindings>
								<!-- Enter sends the command, the same as the Send button -->
								<KeyBinding Key="Return" Command="{Binding SendCommand}" />
							</dxe:TextEdit.InputBindings>
						</dxe:TextEdit>
					</DockPanel>
					<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
						<dxe:CheckEdit VerticalAlignment="Center" Margin="0,0,24,0" FontSize="11" LayoutTransform="1.5,0,0,1.5,0,0" Content="Show response" IsChecked="{Binding ReportSendResponse}"
								ToolTip="Wait for the board to finish the command and show what it replies in the messages. Don't use this for commands that stop the board, such as M112." />
						<TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Timeout (s)" />
						<dxe:SpinEdit Width="120" VerticalAlignment="Center" IsFloatValue="False" EditValueType="{x:Type sys:Int32}" Increment="1" MinValue="1" MaxValue="86400"
								EditValue="{Binding SendTimeoutSeconds}"
								ToolTip="How long to wait for the board to finish the command and reply, when Show response is ticked. Starts as the general board timeout from Settings." />
					</StackPanel>
					<TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" Text="Board Management" />
					<ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Boards}" IsTabStop="False">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<dx:SimpleButton CornerRadius="3" Padding="16,12,16,12" Margin="0,0,6,6" Content="{Binding}" ContentStringFormat="Board {0} Diagnostics"
										Command="{Binding DataContext.GetBoardDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
										ToolTip="Ask this board for its diagnostics (M122) and show them in a window" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<dx:SimpleButton DockPanel.Dock="Top" HorizontalAlignment="Left" CornerRadius="3" Padding="16,12,16,12" Margin="0,0,0,14" Command="{Binding ReleaseComPortCommand}" Content="Release COM Port"
							IsEnabled="{DXBinding '!IsCommandQueueBusy'}" ToolTipService.ShowOnDisabled="True"
							ToolTip="Close the controller board's COM port so a terminal program can open it (only one program can have it open at a time). The next command sent from here reopens it, so close the terminal first. Unavailable while commands are queued or executing." />
					<!-- the two clear buttons share a row. Clear Command Queue discards what is waiting to run; the command being executed always
					     finishes (the board reads nothing more over USB until it has) -->
					<UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,10,0,8">
						<dx:SimpleButton CornerRadius="3" Padding="8,12,8,12" Margin="0,0,3,0" Command="{Binding ClearCommandQueueCommand}" Content="Clear Command Queue"
								ToolTipService.ShowOnDisabled="True"
								ToolTip="{DXBinding 'IsAssayRunning ? `Not available while an assay is running; cancel the assay from the assay screen instead` : `Discards every command that is waiting to run. The command being executed is not interrupted: a move or homing already under way finishes.`'}" />
						<dx:SimpleButton CornerRadius="3" Padding="8,12,8,12" Margin="3,0,0,0" Command="{Binding ClearMessagesCommand}" Content="Clear Messages"
								ToolTip="Empties the Messages list." />
					</UniformGrid>
					<StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
						<TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="Command queue" />
						<TextBlock Opacity="0.7" Text="Nothing queued" Visibility="{DXBinding 'CommandQueue.Items.Count == 0 ? $Visibility.Visible : $Visibility.Collapsed'}" />
						<local:LiveListBox ItemsSource="{Binding CommandQueue.Items}" ItemTemplate="{StaticResource QueuedCommandTemplate}" FontSize="15" MaxHeight="200"
								Background="Transparent" BorderThickness="1" IsTabStop="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								Visibility="{DXBinding 'CommandQueue.Items.Count == 0 ? $Visibility.Collapsed : $Visibility.Visible'}" />
					</StackPanel>
					<TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="Messages" />
					<local:LiveListBox FontSize="15" ItemsSource="{Binding ConsoleMessages}" Background="Transparent" BorderThickness="1" IsTabStop="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding}" Margin="0,1,0,0" TextWrapping="Wrap" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</local:LiveListBox>
				</DockPanel>
			</Border>
		</DockPanel>
		<!-- turns typing with the on-screen keyboard on and off; the same button is in the lower right corner of every window -->
		<local:OnScreenInputToggle Grid.Column="0" Grid.ColumnSpan="2" />
	</Grid>
</dx:ThemedWindow>
